{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "nodemon --exec ts-node src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "node scripts/generate-clients.cjs && tsc -p tsconfig.json",
    "prisma:generate": "node scripts/generate-clients.cjs",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "pool:generate": "node scripts/generate-clients.cjs",
    "pool:migrate": "prisma migrate dev --schema prisma-pool/schema.prisma --name init",
    "pool:migrate:deploy": "prisma migrate deploy --schema prisma-pool/schema.prisma",
    "seed": "ts-node src/seed.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run --reporters clear-text,json",
    "fetch-icons": "ts-node scripts/fetch-icons.ts",
    "fetch-team-logos": "ts-node scripts/fetch-team-logos.ts",
    "fetch-hero-meta": "ts-node scripts/fetch-hero-meta.ts",
    "refetch-incomplete-hero-meta": "ts-node scripts/refetch-incomplete-hero-meta.ts",
    "recompute-presumed-positions": "ts-node scripts/recompute-presumed-positions.ts",
