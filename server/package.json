    "relabel-ti-playoff-teams": "ts-node scripts/relabel-ti-playoff-teams.ts",
    "backfill-legacy-player-pool": "ts-node scripts/backfill-legacy-player-pool.ts",
    "backfill-pro-player-names": "ts-node scripts/backfill-pro-player-names.ts",
    "compute-axis-percentiles": "ts-node scripts/compute-axis-percentiles.ts",
    "calibrate-evaluation-values": "ts-node scripts/calibrate-evaluation-values.ts",
    "calibrate-battle-engine": "ts-node scripts/calibrate-battle-engine.ts",
    "run-axis-regression-b0": "ts-node scripts/run-axis-regression-b0.ts",
    "measure-tag-batch": "ts-node scripts/measure-tag-batch.ts",
