    "export-ability-tagging": "ts-node scripts/export-ability-tagging.ts",
    "import-ability-tagging": "ts-node scripts/import-ability-tagging.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "shared": "*"
