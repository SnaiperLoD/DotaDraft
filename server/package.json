{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "nodemon --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "pool:generate": "prisma generate --schema prisma-pool/schema.prisma",
    "pool:migrate": "prisma migrate dev --schema prisma-pool/schema.prisma --name init",
    "seed": "ts-node src/seed.ts",
    "test": "jest",
    "fetch-icons": "ts-node scripts/fetch-icons.ts",
    "fetch-hero-meta": "ts-node scripts/fetch-hero-meta.ts",
    "fetch-pro-matches": "ts-node scripts/fetch-pro-matches.ts",
    "seed-opponent-pool": "ts-node scripts/seed-opponent-pool.ts",
    "calibrate-evaluation-values": "ts-node scripts/calibrate-evaluation-values.ts",
    "generate-hero-abilities-skeleton": "ts-node scripts/generate-hero-abilities-skeleton.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "shared": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
