// Separate schema for the Opponent Pool — the one subsystem that needs
// shared, dynamically-updated storage instead of the local SQLite datasource
// used by prisma/schema.prisma (see Blueprint/01-core-rules.md Data Rule
// exception, Blueprint/06-battle-engine.md Implementation Decisions).
generator client {
  provider = "prisma-client-js"
  output   = "../generated/pool-client"
}

datasource db {
  provider = "postgresql"
  url      = env("POOL_DATABASE_URL")
}

model PooledDraft {
  id             String   @id @default(uuid())
  source         String   @default("player") // "player" | "pro"
  submitterToken String?
  heroIds        Json
  // {heroId: number, role: string}[], same order as heroIds. Nullable —
  // rows committed before role-fit reached Battle Engine have no role
  // data; resolveBattle treats a null/missing role as "no boost" rather
  // than erroring (see Blueprint/10-tech-debt-backlog.md, "Role-fit in
  // Battle Engine").
  heroRoles      Json?
  teamName       String?
  leagueName     String?
  createdAt      DateTime @default(now())
}

// "Weak" leaderboard (Blueprint/10-tech-debt-backlog.md, "Лидерборд") —
// aggregated per anonymous submitterToken (the same client-generated
// localStorage UUID used to commit to the Opponent Pool), not a real
// account system. One row per token, incremented in place on every fight
// (BattleService.fight()) rather than one row per battle — this is a
// counter table, not a history log (BattleResult in the local SQLite
// schema already covers per-battle history for the browser that played
// it). Explicitly gameable (unlimited free fights per visit already exist
// in Battle Mode) and resets to a new row if the user clears
// localStorage — acceptable for what this is, a lightweight ranking, not
// a competitive-integrity leaderboard.
model LeaderboardEntry {
  submitterToken String   @id
  wins           Int      @default(0)
  losses         Int      @default(0)
  updatedAt      DateTime @updatedAt
}
