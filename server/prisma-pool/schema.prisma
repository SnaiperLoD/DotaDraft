// Separate schema for the Opponent Pool — the one subsystem that needs
// shared, dynamically-updated storage instead of the local SQLite datasource
// used by prisma/schema.prisma (see Blueprint/01-core-rules.md Data Rule
// exception, Blueprint/06-battle-engine.md Implementation Decisions).
generator client {
  provider = "prisma-client-js"
  output   = "../generated/pool-client"
}

datasource db {
  provider = "postgresql"
  url      = env("POOL_DATABASE_URL")
}

model PooledDraft {
  id             String   @id @default(uuid())
  source         String   @default("player") // "player" | "pro"
  submitterToken String?
  heroIds        Json
  // {heroId: number, role: string}[], same order as heroIds. Nullable —
  // rows committed before role-fit reached Battle Engine have no role
  // data; resolveBattle treats a null/missing role as "no boost" rather
  // than erroring (see Blueprint/10-tech-debt-backlog.md, "Role-fit in
  // Battle Engine").
  heroRoles      Json?
  teamName       String?
  leagueName     String?
  // Blueprint/10-tech-debt-backlog.md, "Лидерборд драфтов" — snapshot of
  // EvaluationResult.totalScore at commit time (null if the draft was
  // never evaluated before committing). Not kept live-updated if the
  // local draft is re-evaluated afterward — a leaderboard row is a
  // snapshot of the draft as committed, not a synced mirror.
  evaluationScore Float?
  // Wins/losses are for THIS draft as the OPPONENT (pulled by
  // pullRandom() into someone ELSE's battle) — NOT for the committing
  // player's own battles played with other drafts. Incremented directly
  // on this row (not a separate join table) since each row already IS
  // one specific draft. Replaces the earlier submitterToken-keyed
  // LeaderboardEntry model (removed) — "weak" in the same sense that one
  // was: gameable, no minimum-battle floor.
  wins           Int      @default(0)
  losses         Int      @default(0)
  createdAt      DateTime @default(now())
}
