generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hero {
  id                Int      @id
  name              String
  primaryAttribute  String
  attackType        String
  roles             String
  tags              String
  synergyTags       String
  counterTags       String
  evaluationValues  String
  evaluationValuesByRole String @default("{}")
  presumedPositions String   @default("[]")
}

model Draft {
  id               String       @id @default(uuid())
  status           String       @default("PICKING")
  seed             Int
  pool             String
  // Anonymous browser identity (same UUID the client stores as
  // submitterToken). Required on create. Private reads/writes 404 unless
  // the header matches. Null on pre-ownership rows — those stay
  // inaccessible rather than world-readable.
  ownerToken       String?
  // One-time reroll of the current round's pool (Blueprint/10-tech-debt-backlog.md,
  // "Кнопка реролла пула героев") — decremented to 0 on use, never
  // replenished mid-draft.
  rerollsRemaining Int          @default(1)
  createdAt        DateTime     @default(now())
  heroes           DraftHero[]
  // Most recent EvaluationResult for this draft (JSON-stringified), written
  // by EvaluationService.evaluate() whenever it's computed — nullable, a
  // draft only has one once Evaluate Draft has been clicked at least once
  // (Blueprint/10-tech-debt-backlog.md, "Сохранять в истории результаты
  // боёв"). Overwritten on each re-evaluate, not versioned — the history
  // feature this backs wants "what does this draft evaluate as", not a
  // point-in-time snapshot per past calibration.
  evaluationResult String?
  battleResults    BattleResult[]

  @@index([ownerToken])
}

// One row per Battle Mode fight against this draft — a draft can be fought
// multiple times ("series of battles" in 06-battle-engine.md is still
// unbuilt, but this 1:many shape means History doesn't need reshaping when
// it lands). Written by BattleService.fight() after each resolveBattle()
// call. Denormalized opponent fields (not a foreign key to PooledDraft)
// because a 'player'-sourced opponent may itself later be purged/replaced
// in the Opponent Pool — the battle record should stay meaningful on its
// own regardless of what happens to the pool afterward.
model BattleResult {
  id                 Int      @id @default(autoincrement())
  draftId            String
  draft              Draft    @relation(fields: [draftId], references: [id])
  resolvedOutcome    String
  advantageDirection String
  confidenceTier     String
  opponentSource     String
  opponentTeamName   String?
  opponentLeagueName String?
  opponentHeroIds    String
  createdAt          DateTime @default(now())
}

model DraftHero {
  id            Int     @id @default(autoincrement())
  draftId       String
  heroId        Int
  assignedRole  String?
  pickOrder     Int
  draft         Draft   @relation(fields: [draftId], references: [id])

  @@unique([draftId, heroId])
}

model ProMatch {
  id               String   @id
  radiantName      String?
  direName         String?
  leagueName       String?
  radiantWin       Boolean
  radiantHeroIds   String
  direHeroIds      String
  // JSON-stringified PooledHeroRole[] (shared/types/opponent-pool.ts),
  // GPM-rank-derived — null for rows seeded before role-fit reached pro
  // matches (see Blueprint/10-tech-debt-backlog.md, "Role-fit in Battle
  // Engine").
  radiantHeroRoles String?
  direHeroRoles    String?
  startTime        DateTime
  createdAt        DateTime @default(now())
}
