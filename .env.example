# Copy to .env (never commit real secrets). Paths are relative to server/
# when running Nest from the server workspace.

# SQLite app DB (heroes, drafts, history, battles)
DATABASE_URL=file:../../database/dev.db

# Opponent Pool (Postgres). Compose wires this to the `pool` service.
# Empty disables Battle pulls / pool commit / pool leaderboard (local npm start).
# Example matching docker-compose.yml:
# POOL_DATABASE_URL=postgresql://dota:dota@127.0.0.1:5432/opponent_pool
POOL_DATABASE_URL=

# HTTP
PORT=3001
NODE_ENV=development

# Closed-alpha funnel dump. GET /telemetry/funnel requires this as
# X-Telemetry-Read-Token. Unset = endpoint 404s (no public dashboard).
TELEMETRY_READ_TOKEN=

# Comma-separated allowed browser origins. Empty in development = open CORS.
# In production behind the compose nginx (same origin), leave empty.
# Example for a split host: https://draft.example.com,http://localhost:5173
CORS_ORIGIN=
